{
  "name": "quassel-workspace",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @schlenkr/quassel css && pnpm --parallel --filter @schlenkr/quassel --filter gallery dev",
    "build": "pnpm --filter @schlenkr/quassel css && pnpm --filter gallery build",
    "check": "pnpm --filter @schlenkr/quassel check && pnpm --filter gallery exec tsc --noEmit",
    "test": "pnpm --filter @schlenkr/quassel test",
    "release": "node scripts/publish.mjs"
  }
}
