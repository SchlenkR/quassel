{
  "name": "quassel",
  "version": "0.2.0",
  "description": "Chat building blocks for React: streaming transcript with thinking and tool steps, input card, themable Tailwind styles and an event contract",
  "license": "MIT",
  "author": "Ronald Schlenker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SchlenkR/quassel.git"
  },
  "homepage": "https://github.com/SchlenkR/quassel#readme",
  "keywords": ["chat", "react", "llm", "agent", "streaming", "ui", "tailwind"],
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": "./src/index.ts",
    "./events": "./src/events.ts",
    "./chat.css": "./build/chat.css"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "css": "tailwindcss -i src/chat.css -o build/chat.css",
    "dev": "tailwindcss -i src/chat.css -o build/chat.css --watch"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "streamdown": "^2.6.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0"
  }
}
